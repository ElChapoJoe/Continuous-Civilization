		<ActionGroup id="cc-import-dlc-nepal" scope="game" criteria="antiquity-with-nepal">
			<Properties><LoadOrder>650</LoadOrder></Properties>
			<Actions>
				<UpdateDatabase>
					<Item>{nepal}data/constructibles-modern.xml</Item>
					<Item>{nepal}data/constructibles-gameeffects.xml</Item>
					<Item>{nepal}data/progression-trees-culture-unique.xml</Item>
					<Item>{nepal}data/progression-trees-culture-unique-ex.xml</Item>
