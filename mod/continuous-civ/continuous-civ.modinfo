					<Item>{england}data/progression-trees-culture-unique-mo.xml</Item>
					<Item>{england}data/civilizations-gameeffects.xml</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>
		<ActionGroup id="cc-import-dlc-goryeo" scope="game" criteria="antiquity-with-goryeo">
			<Properties><LoadOrder>650</LoadOrder></Properties>
			<Actions>
				<UpdateDatabase>
					<Item>{goryeo}data/progression-trees-culture-unique.xml</Item>
