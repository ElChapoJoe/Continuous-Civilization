		<ActionGroup id="cc-import-dlc-joseon" scope="game" criteria="antiquity-with-joseon">
			<Properties><LoadOrder>650</LoadOrder></Properties>
			<Actions>
				<UpdateDatabase>
					<Item>{joseon}data/progression-trees-culture-unique.xml</Item>
