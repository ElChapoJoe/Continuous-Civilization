<?xml version="1.0" encoding="utf-8"?>
<Mod id="cc-probe" version="1" xmlns="ModInfo">
	<Properties>
		<Name>Continuous Civ - Phase 1 Probe (diagnostic)</Name>
		<Description>Diagnostic only. Freezes the Antiquity age clock and loads Exploration tech/units/buildings into Antiquity via cross-module references.</Description>
		<Authors>Continuous Civilization</Authors>
		<AffectsSavedGames>1</AffectsSavedGames>
	</Properties>
	<Dependencies>
		<Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME"/>
		<Mod id="age-antiquity" title="Age - Antiquity"/>
		<Mod id="age-exploration" title="Age - Exploration"/>
	</Dependencies>
	<ActionCriteria>
		<Criteria id="antiquity-age-current">
			<AgeInUse>AGE_ANTIQUITY</AgeInUse>
		</Criteria>
	</ActionCriteria>
	<ActionGroups>
		<ActionGroup id="cc-probe-pre-dedupe" scope="game" criteria="antiquity-age-current">
			<Properties><LoadOrder>400</LoadOrder></Properties>
			<Actions>
				<UpdateDatabase>
					<Item>data/pre-dedupe.sql</Item>
				</UpdateDatabase>
				<UpdateText>
					<Item>data/pre-dedupe-text.sql</Item>
				</UpdateText>
			</Actions>
		</ActionGroup>
		<ActionGroup id="cc-probe-load-exploration" scope="game" criteria="antiquity-age-current">
			<Properties><LoadOrder>500</LoadOrder></Properties>
			<Actions>
				<UpdateDatabase>
					<Item>{age-exploration}data/constructibles.xml</Item>
					<Item>{age-exploration}data/constructibles-gameeffects.xml</Item>
					<Item>{age-exploration}data/units.xml</Item>
					<Item>{age-exploration}data/units-gameeffects.xml</Item>
					<Item>{age-exploration}data/progression-trees-tech.xml</Item>
					<Item>{age-exploration}data/progression-trees-tech-gameeffects.xml</Item>
				</UpdateDatabase>
				<UpdateText>
					<Item>{age-exploration}text/en_us/TechnologiesText.xml</Item>
				</UpdateText>
			</Actions>
		</ActionGroup>
		<ActionGroup id="cc-probe-graft-and-freeze" scope="game" criteria="antiquity-age-current">
			<Properties><LoadOrder>1000</LoadOrder></Properties>
			<Actions>
				<UpdateDatabase>
					<Item>data/graft-and-freeze.sql</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>
	</ActionGroups>
</Mod>
